# ==============================================================================
# FITTRACK AI — Environment Configuration Template
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=True

# JWT & API Security Secret (Replace with a 64+ char random hex string in prod)
SECRET_KEY=fittrack_ai_super_secret_jwt_key_for_development_purposes_only_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Primary Database Connection
# SQLite Async (Default for local zero-config zero-latency testing):
DATABASE_URL=sqlite+aiosqlite:///./fittrack.db
# PostgreSQL / Supabase Async (For production cloud deployments):
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres

# Multimodal Vision AI Provider
# "gemini" uses Google Gemini 1.5 Flash Vision
# "mock" uses internal multi-item plate heuristic simulation
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_TIMEOUT_SECONDS=15

# Upload Directory for Scanned Meal Photographs
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_BYTES=10485760

# Speech Recognition & OCR Configuration
VOICE_PARSER_PROVIDER=heuristic
OCR_PROVIDER=heuristic
